@using Veterinaria.Blazor.Models
@using Veterinaria.Blazor.Services
@inject ComunicacionesService Servicio

@* A-028, RF-CLI-18, RF-CLI-20: preferencias por tipo de comunicación y bandeja del cliente. Los opcionales arrancan apagados (RN-43). *@
<section class="mb-4" aria-labelledby="titulo-comunicaciones">
    <h2 class="h4" id="titulo-comunicaciones">Mis comunicaciones</h2>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(exito ? "alert-success" : "alert-danger")" role="@(exito ? "status" : "alert")">@mensaje</div>
    }

    <h3 class="h6">¿Cómo querés recibir cada aviso?</h3>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <caption class="visually-hidden">Canal elegido para cada tipo de comunicación</caption>
            <thead>
                <tr><th scope="col">Tipo</th><th scope="col">Canal</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < preferencias.Count; i++)
                {
                    var fila = preferencias[i];
                    var nombre = fila.Tipo.Nombre;
                    var idCampo = $"pref-comunicacion-{i}";
                    <tr>
                        <td>
                            <label for="@idCampo" class="fw-bold">@nombre</label>
                            <span class="d-block small text-muted">@fila.Tipo.Descripcion @(fila.Tipo.Esencial ? "Es parte del servicio." : "Es opcional.")</span>
                        </td>
                        <td style="min-width: 11rem;">
                            <select id="@idCampo" class="form-select form-select-sm" value="@fila.Canal" @onchange="e => Cambiar(nombre, e)">
                                <option value="@ComunicacionesService.Correo">@ComunicacionesService.Correo</option>
                                <option value="@ComunicacionesService.SoloApp">@ComunicacionesService.SoloApp</option>
                                @if (!fila.Tipo.Esencial)
                                {
                                    <option value="@ComunicacionesService.Ninguno">@ComunicacionesService.Ninguno</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h3 class="h6 mt-3">Mensajes (@mensajes.Count)</h3>
    @if (mensajes.Count == 0)
    {
        <p>Todavía no tenés mensajes. El resumen de cada consulta aparece acá y, si lo elegiste, también llega por correo.</p>
    }
    else
    {
        <ul class="list-group">
            @foreach (var comunicacion in mensajes)
            {
                var id = comunicacion.Id;
                <li class="list-group-item">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>
                            <strong>@comunicacion.Asunto</strong>
                            @if (!comunicacion.Leida)
                            {
                                <span class="badge bg-primary ms-1">Nuevo</span>
                            }
                            <span class="d-block small text-muted">@comunicacion.Tipo · @comunicacion.FechaCreacion.ToString("dd/MM/yyyy HH:mm") · @comunicacion.Canal · @comunicacion.Estado</span>
                        </span>
                        <button type="button" class="btn btn-outline-primary btn-sm" aria-expanded="@(abiertos.Contains(id) ? "true" : "false")" @onclick="() => Alternar(id)">@(abiertos.Contains(id) ? "Ocultar" : "Leer")</button>
                    </div>
                    @if (abiertos.Contains(id))
                    {
                        <p class="mt-2 mb-0" style="white-space: pre-line;">@comunicacion.Cuerpo</p>
                    }
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter]
    public Cuenta Cuenta { get; set; } = new();

    private List<(TipoComunicacion Tipo, string Canal)> preferencias = new();
    private List<Comunicacion> mensajes = new();
    private HashSet<int> abiertos = new();
    private string mensaje = "";
    private bool exito;

    protected override void OnParametersSet()
    {
        Cargar();
    }

    private void Cargar()
    {
        preferencias = Servicio.PreferenciasDe(Cuenta.Id);
        mensajes = Servicio.DeCuenta(Cuenta.Id);
    }

    private void Cambiar(string tipo, ChangeEventArgs e)
    {
        var resultado = Servicio.CambiarPreferencia(Cuenta.Id, tipo, e.Value?.ToString() ?? "");
        mensaje = resultado.Mensaje;
        exito = resultado.Exito;
        Cargar();
    }

    private void Alternar(int id)
    {
        if (!abiertos.Remove(id))
        {
            abiertos.Add(id);
            Servicio.MarcarLeida(id, Cuenta.Id);
        }

        Cargar();
    }
}
