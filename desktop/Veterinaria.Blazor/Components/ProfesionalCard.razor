@using Veterinaria.Blazor.Models

<div class="card mb-3 h-100">
    <div class="card-body">
        <h2 class="h5 card-title">@Profesional.Nombre</h2>
        <p class="card-subtitle text-muted mb-2">@Profesional.Especialidad</p>
        <p class="card-text">@Profesional.Descripcion</p>
        <a class="btn btn-outline-secondary btn-sm" href="@($"profesionales/{Profesional.Id}")">Ver horarios</a>
    </div>
</div>

@code {
    [Parameter]
    public Profesional Profesional { get; set; } = new();
}
