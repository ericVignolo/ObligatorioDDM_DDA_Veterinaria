@page "/panel/mi-agenda"
@using Veterinaria.Blazor.Models
@using Veterinaria.Blazor.Services
@inject AgendaService Agenda
@inject AnimalService AnimalService
@inject PrestacionService PrestacionService
@inject SesionService Sesion
@inject ConsultaService Consultas
@inject NavigationManager Navegacion

<PageTitle>Mi agenda — VITALIA</PageTitle>

<RequierePersonal Roles="@(new[] { PersonalService.Veterinario })">
    <h1>Mi agenda</h1>
    <p class="text-muted">@Sesion.PersonalActual!.Nombre · solo tus turnos.</p>

    <div class="mb-3" style="max-width: 16rem;">
        <label class="form-label" for="fecha">Día</label>
        <input id="fecha" type="date" class="form-control" value="@fecha.ToString("yyyy-MM-dd")" @onchange="CambiarFecha" />
        <div class="form-text">@fecha.ToString("dddd d 'de' MMMM")</div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert alert-danger" role="alert">@mensaje</div>
    }

    @if (abiertas.Count > 0)
    {
        @* P-RC-04: consultas sin cerrar para resolver antes de terminar el día. *@
        <div class="alert alert-warning">
            <strong>Consultas abiertas:</strong>
            @foreach (var abierta in abiertas)
            {
                <a class="ms-2" href="@($"panel/consulta/{abierta.TurnoId}")">@(AnimalService.ObtenerParaPersonal(abierta.AnimalId)?.Nombre) (@abierta.FechaInicio.ToString("dd/MM HH:mm"))</a>
            }
        </div>
    }

    @if (enEspera > 0)
    {
        <div class="alert alert-info" role="status">Hay @enEspera @(enEspera == 1 ? "paciente" : "pacientes") en espera.</div>
    }

    @if (turnos.Count == 0)
    {
        <p>No tenés turnos este día.</p>
    }
    else
    {
        <div class="list-group mb-3">
            @foreach (var turno in turnos)
            {
                var animal = AnimalService.ObtenerParaPersonal(turno.AnimalId);
                <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <strong>@turno.Inicio.ToString("HH:mm")–@turno.Fin.ToString("HH:mm")</strong>
                        · @animal?.Nombre <span class="text-muted">(@animal?.Especie)</span>
                        · @(PrestacionService.ObtenerPorId(turno.PrestacionId)?.Nombre)
                    </div>
                    <div>
                        <EstadoTurno Estado="@turno.Estado" />
                        @if (turno.Estado == "En espera")
                        {
                            <button class="btn btn-success btn-sm ms-2" @onclick="() => IniciarAtencion(turno.Id)">Iniciar atención</button>
                        }
                        else if (turno.Estado == "En curso")
                        {
                            <a class="btn btn-outline-success btn-sm ms-2" href="@($"panel/consulta/{turno.Id}")">Continuar consulta</a>
                        }
                        else if (turno.Estado == "Finalizado")
                        {
                            <a class="btn btn-outline-secondary btn-sm ms-2" href="@($"panel/consulta/{turno.Id}")">Ver consulta</a>
                        }
                        <a class="btn btn-link btn-sm" href="@($"panel/historia/{turno.AnimalId}")">Historia</a>
                    </div>
                </div>
            }
        </div>
        <p class="text-muted small">«Iniciar atención» aparece cuando Recepción registra la llegada. La historia de un animal sin turno activo pide un motivo (P-RC-05).</p>
    }
</RequierePersonal>

@code {
    private DateOnly fecha = DateOnly.FromDateTime(DateTime.Today);
    private List<Turno> turnos = new();
    private int enEspera;
    private List<Consulta> abiertas = new();
    private string mensaje = "";

    protected override void OnInitialized()
    {
        Cargar();
    }

    private void Cargar()
    {
        var profesionalId = Sesion.PersonalActual?.ProfesionalId;
        turnos = profesionalId is null ? new() : Agenda.TurnosDelDia(fecha, profesionalId);
        enEspera = turnos.Count(t => t.Estado == "En espera");
        abiertas = Sesion.PersonalActual is null ? new() : Consultas.AbiertasDe(Sesion.PersonalActual.Id);
    }

    private void IniciarAtencion(int turnoId)
    {
        var resultado = Consultas.Iniciar(turnoId, Sesion.PersonalActual, out _);
        if (resultado.Exito)
        {
            Navegacion.NavigateTo($"panel/consulta/{turnoId}");
            return;
        }

        mensaje = resultado.Mensaje;
        Cargar();
    }

    private void CambiarFecha(ChangeEventArgs e)
    {
        if (DateOnly.TryParse(e.Value?.ToString(), out var nueva))
        {
            fecha = nueva;
            Cargar();
        }
    }
}
