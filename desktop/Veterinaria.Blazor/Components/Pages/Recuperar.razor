@page "/recuperar"
@using Veterinaria.Blazor.Models
@using Veterinaria.Blazor.Services
@inject CuentaService CuentaService
@inject NavigationManager Navegacion

<PageTitle>Recuperar contraseña — VITALIA</PageTitle>

<h1>Recuperar contraseña</h1>
<p>Escribí el correo de tu cuenta y te enviamos un código para crear una contraseña nueva.</p>

@* Recuperación con código por correo (A-007, D-REG-03). *@
<EditForm Model="solicitud" OnValidSubmit="Pedir" FormName="recuperar">
    <DataAnnotationsValidator />
    <div style="max-width: 24rem;">
        <div class="mb-3">
            <label class="form-label" for="correo">Correo electrónico</label>
            <InputText id="correo" type="email" class="form-control" @bind-Value="solicitud.Correo" autocomplete="email" />
            <ValidationMessage For="() => solicitud.Correo" />
        </div>
        <button type="submit" class="btn btn-primary">Enviarme un código</button>
        <a class="btn btn-link" href="ingresar">Volver a ingresar</a>
    </div>
</EditForm>

@code {
    private SolicitudRecuperacion solicitud = new();

    private void Pedir()
    {
        CuentaService.SolicitarRecuperacion(solicitud.Correo);
        Navegacion.NavigateTo("restablecer");
    }
}
