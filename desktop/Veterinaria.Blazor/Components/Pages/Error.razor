@page "/Error"
@using System.Diagnostics

<PageTitle>Error — VITALIA</PageTitle>

<h1 class="text-danger">Ocurrió un error.</h1>
<h2 class="text-danger h4">No pudimos procesar tu pedido.</h2>
<p>Probá de nuevo en unos minutos. Si el problema sigue, avisá a la clínica.</p>

@if (ShowRequestId)
{
    <p>
        <strong>Código del pedido:</strong> <code>@RequestId</code>
    </p>
}

<a class="btn btn-primary" href="">Volver al inicio</a>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
