@using Veterinaria.Blazor.Services
@implements IDisposable
@inject SesionService Sesion
@inject NavigationManager Navegacion

@* Barra superior: muestra quién ingresó y permite salir (A-008). *@
@if (Sesion.EsPersonal)
{
    <span class="me-3">@Sesion.PersonalActual!.Nombre <span class="badge bg-secondary">@Sesion.PersonalActual.Rol</span></span>
    <a href="panel" class="me-3">Panel</a>
    <button class="btn btn-link p-0" @onclick="CerrarSesion">Cerrar sesión</button>
}
else if (Sesion.Iniciada)
{
    <span class="me-3">Hola, <strong>@Sesion.CuentaActual!.Nombre</strong></span>
    <a href="animales" class="me-3">Mis animales</a>
    <a href="turnos" class="me-3">Mis turnos</a>
    <a href="cuenta" class="me-3">Mi cuenta</a>
    <button class="btn btn-link p-0" @onclick="CerrarSesion">Cerrar sesión</button>
}
else
{
    <a href="ingresar" class="me-3">Ingresar</a>
    <a href="registro">Crear cuenta</a>
}

@code {
    protected override void OnInitialized()
    {
        Sesion.Cambio += Actualizar;
    }

    private void Actualizar()
    {
        InvokeAsync(StateHasChanged);
    }

    private void CerrarSesion()
    {
        Sesion.Salir();
        Navegacion.NavigateTo("");
    }

    public void Dispose()
    {
        Sesion.Cambio -= Actualizar;
    }
}
